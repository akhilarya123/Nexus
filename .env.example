# =============================================================================
# NEXUS — Environment Configuration
# Copy this to .env and edit as needed.
# All defaults point to local Docker services — no paid APIs required.
# =============================================================================

# ---- Kernel ----
NEXUS_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ---- Ollama (local LLM — gemma3) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3          # or gemma3:12b, gemma3:27b etc.
OLLAMA_FAST_MODEL=gemma3     # used for cheap MCTS rollouts
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=120

# ---- Neo4j (Graph DB) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nexuspassword
NEO4J_DATABASE=neo4j
NEO4J_MAX_DEPTH=3
NEO4J_MAX_NODES=500

# ---- Qdrant (Vector DB) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_LOGS=nexus_execution_logs
QDRANT_COLLECTION_TOOLS=nexus_tool_schemas
QDRANT_VECTOR_SIZE=384

# ---- Redis (Cache / Celery broker) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=   # leave blank for local dev

# ---- Observability ----
OTEL_ENABLED=true
OTEL_SERVICE_NAME=nexus-kernel
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLE_RATE=1.0
LOG_LEVEL=INFO

# ---- MCTS Hyperparameters ----
MCTS_C=1.414         # UCT exploration constant
MCTS_MAX_DEPTH=50
MCTS_NUM_SIMULATIONS=20
MCTS_MAX_HORIZON=1000
